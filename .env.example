# Copie para .env e preencha. O arquivo .env NÃO deve ir para o Git.

# Domínio apontado (registro A) para o IP do servidor. O Caddy obtém o HTTPS sozinho.
# Para testar localmente use: DOMAIN=localhost
DOMAIN=cestimo.exemplo.com.br

# Senha de /metrics e /admin/stats (usuário: qualquer um). Gere uma forte:
#   openssl rand -base64 24
METRICS_TOKEN=troque-por-uma-senha-forte

# Nome exibido no site
APP_NAME=Cestimo

# Limites contra abuso (padrões: 20 comparações por IP por hora; 2 comparações simultâneas)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MIN=60
MAX_CONCURRENT=2
