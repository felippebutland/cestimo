# Copie para .env e preencha. O arquivo .env NÃO deve ir para o Git.

# Domínio apontado (registro A) para o IP do servidor. O Caddy obtém o HTTPS sozinho.
# Para testar localmente use: DOMAIN=localhost
DOMAIN=cestimo.exemplo.com.br

# Senha de /metrics e /admin/stats (usuário: qualquer um). Gere uma forte:
#   openssl rand -base64 24
METRICS_TOKEN=troque-por-uma-senha-forte

# Nome exibido no site
APP_NAME=Cestimo

# Limites contra abuso (padrões: 20 comparações por IP por hora; 2 comparações simultâneas)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MIN=60
MAX_CONCURRENT=2

# Fuso dos gráficos por dia, em minutos em relação ao UTC (-180 = horário de Brasília)
TZ_OFFSET_MIN=-180

# Só se for usar os gráficos do Grafana (perfil "monitoring"): senha do usuário admin
GRAFANA_PASSWORD=

# Login com Google (opcional). Crie uma credencial OAuth "Aplicativo da Web" no Google Cloud Console e cadastre
# o URI de redirecionamento: <PUBLIC_URL>/api/auth/google/callback. Sem os três valores, o login não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://cestimo.exemplo.com.br

# Alertas do Grafana no Telegram (opcional). Crie um bot no @BotFather, cole o token aqui, mande "oi" para o bot e rode
# scripts/telegram-setup.sh: ele descobre o TELEGRAM_CHAT_ID, manda uma mensagem de teste e liga os alertas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Endereço público do Grafana (opcional; padrão https://<DOMAIN>/grafana/). Com Cloudflare Tunnel: https://grafana.seudominio.com/grafana/
GRAFANA_ROOT_URL=

# Coleta noturna (opcional): lê config/seed-products.json e guarda preços e títulos dos mercados. Padrões abaixo.
# SEED_REFRESH_HOUR=3        # hora local em que a rodada começa
# SEED_WINDOW_HOURS=4        # só roda nesta janela (3h às 7h); fora dela nunca dispara
# SEED_BATCH_SIZE=1          # produtos consultados ao mesmo tempo (cada um vai a todas as lojas)
# SEED_PAUSE_SECONDS=3       # pausa entre lotes
# SEED_MAX_MINUTES=240       # tempo máximo da rodada; o que sobrar fica para o dia seguinte
# SEED_FILE=                 # outro arquivo de lista base
